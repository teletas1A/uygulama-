{
  "name": "guvenli-bordro",
  "version": "1.0.0",
  "description": "Güvenli Bordro Yönetim Paneli",
  "main": "main.js",
  "author": "Guvenli Bordro",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.guvenlibordro.yonetim",
    "productName": "Güvenli Bordro",
    "directories": { "output": "dist" },
    "files": ["main.js", "offline.html"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Güvenli Bordro"
    }
  }
}
